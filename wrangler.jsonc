{
  "name": "paper-reader",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "34431cd51da281ed3590ab6ce5141d09",
  "assets": { "directory": "./dist", "binding": "ASSETS", "html_handling": "none", "run_worker_first": true },
  "r2_buckets": [{ "binding": "PAPERS", "bucket_name": "paper-reader" }],
  "d1_databases": [{ "binding": "DB", "database_name": "paper-reader", "database_id": "44cff9c0-ceac-4609-9724-6c18fb92d400", "migrations_dir": "migrations" }],
  "vars": {
    "GEMINI_MODEL": "gemini-3.8-flash",
    "GEMINI_FAST_MODEL": "gemini-3.5-flash-lite",
    // Clerk application "xyznot.com" (production instance, Frontend API clerk.xyznot.com).
    "CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsueHl6bm90LmNvbSQ",
    "AUTH_ORIGINS": "https://xyznot.com,https://paper.xyznot.com,http://localhost:5178",
    // Clerk Billing plan slug that unlocks AI routes; empty means AI is free for everyone (the
    // personal plan is free). FREE_USERS: Clerk user ids that never pay (owner).
    "PAID_PLAN": "",
    // Clerk Billing organization plan for teams: $10 per member per month, up to 20 members.
    "TEAM_PLAN": "team",
    "FREE_USERS": "user_3LIzmi9iCEL03k6KSsp0t6GkSlJ"
  },
  // Home page search (Querit) is open to signed-out visitors: 20 searches per minute per IP.
  "ratelimits": [{ "name": "SEARCH_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
  "routes": [{ "pattern": "xyznot.com", "custom_domain": true }, { "pattern": "paper.xyznot.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
